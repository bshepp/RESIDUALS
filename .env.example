# RESIDUALS environment configuration
# Copy to .env and fill in values (or export directly in your shell).

# Path to LiDAR tile directory (e.g. Licking County 2015 OSIP data)
# Used by: tile_county.py, trace_road.py, generate_licking_dem.py, generate_test_dem.py
# Can also be passed via --lidar-dir on each script.
RESIDUALS_LIDAR_DIR=
